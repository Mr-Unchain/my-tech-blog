{
  "name": "my-tech-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run validate:content && astro dev --host 127.0.0.1",
    "build": "npm run validate:content && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run validate:content && vitest",
    "test:watch": "vitest -w",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "validate:content": "tsx scripts/validate-content.ts",
    "article:new": "tsx scripts/new-article.ts",
    "articles:import": "node scripts/import-published-articles.mjs",
    "articles:assets": "node scripts/localize-article-images.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "3.7.5",
    "@astrojs/vercel": "11.0.22",
    "@swup/scripts-plugin": "^2.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/react-md-editor": "^4.0.11",
    "cheerio": "^1.2.0",
    "firebase": "13.3.0",
    "microcms-js-sdk": "^3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "swup": "^4.8.2",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@astrojs/partytown": "2.1.9",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.54.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cheerio": "^0.22.35",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "5.1.0",
    "astro": "7.4.12",
    "critters": "^0.0.23",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.97.0",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.1",
    "turndown": "7.2.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.55.0",
    "vitest": "5.1.0",
    "autoprefixer": "10.6.2"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "path-to-regexp": "6.3.0",
    "zod": "4.6.7",
    "postcss-selector-parser@6.0.10": "6.1.6",
    "minimatch@9": "11.0.8"
  }
}
