---
// src/pages/blog/[id].astro
import { Image } from "astro:assets";
import * as cheerio from "cheerio";
import { doc, increment, setDoc } from "firebase/firestore";
import ArticleCard from "../../components/ArticleCard.astro";
import ArticleNavigation from "../../components/ArticleNavigation.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CodeBlockEnhancer from "../../components/CodeBlockEnhancer.astro";
import Comments from "../../components/Comments.astro";
import ImageOptimizer from "../../components/ImageOptimizer.astro";
import KeyboardNavigation from "../../components/KeyboardNavigation.astro";
import LinkStyleEnhancer from "../../components/LinkStyleEnhancer.astro";
import BookmarkButton from "../../components/BookmarkButton";
import ReactionButtons from "../../components/ReactionButtons";
import StickyReactionBar from "../../components/StickyReactionBar";
import TableOfContents from "../../components/TableOfContents";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db } from "../../lib/firebase";
import { getBlogDetail, getBlogs } from "../../lib/microcms";
import { getRelatedPosts } from "../../utils/recommend";
import { getCategoryBadgeClasses, getCategoryIconClass } from "../../utils/categoryColors";

const { id } = Astro.params;
const draftKey = Astro.url.searchParams.get("draftKey");

if (!id) {
  return new Response(null, { status: 404 });
}

// 閲覧数をインクリメント（プレビュー時は抑止）
if (!draftKey && db) {
  const viewRef = doc(db, "views", id);
  await setDoc(viewRef, { count: increment(1) }, { merge: true });
}

const post = await getBlogDetail(id, draftKey ? { draftKey } : undefined);

if (!post) {
  return new Response(null, { status: 404 });
}

// 目次を生成
let headings: { text: string; id: string; tagName: string }[] = [];
if (post.content) {
  const $ = cheerio.load(post.content);
  headings = $("h2, h3")
    .toArray()
    .map((node) => {
      const $el = $(node as any);
      const text = $el.text();
      const id = $el.attr('id') ?? '';
      const tagName = (node as any).name || (node as any).tagName || 'h2';
      return { text, id, tagName };
    });
}

// SEO用のキーワード生成
const categories = Array.isArray(post.category) ? post.category : [post.category];
const categoryNames = categories.filter(Boolean);

// 関連記事取得
const allBlogs = await getBlogs({ limit: 100, orders: "-publishedAt" });
const relatedPosts = getRelatedPosts(post as any, allBlogs.contents as any[]);
const seoKeywords = [...categoryNames, "テクノロジー", "プログラミング", "コーディング", "AI", "開発"].join(", ");

// パンくずナビゲーション
const breadcrumbItems = [
  { name: "ホーム", href: "/" },
  { name: "ブログ", href: "/blog" },
  ...(categoryNames.length > 0 ? [{ name: categoryNames[0], href: `/category/${encodeURIComponent(categoryNames[0])}` }] : []),
  { name: post.title }
];
---

<BaseLayout
  pageTitle={post.title}
  pageDescription={post.description}
  ogImageUrl={post.eyecatch?.url}
  keywords={seoKeywords}
  author="Monologger"
  publishedTime={post.publishedAt}
  modifiedTime={post.updatedAt}
  articleType="article"
>
  <Fragment slot="head">
    {draftKey && (<meta name="robots" content="noindex,nofollow" />)}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_circle_up,cached"
    />

    <script type="application/ld+json" is:inline>{JSON.stringify({
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          "headline": post.title,
          "description": post.description,
          "image": post.eyecatch?.url || new URL("/placeholder.svg", Astro.site).href,
          "datePublished": post.publishedAt,
          "dateModified": post.updatedAt || post.publishedAt,
          "author": {
            "@type": "Person",
            "name": "Monologger",
            "url": new URL("/profile", Astro.site).href
          },
          "publisher": {
            "@type": "Organization",
            "name": "Monologger",
            "logo": {
              "@type": "ImageObject",
              "url": new URL("/logo.svg", Astro.site).href
            }
          },
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": Astro.url.href
          },
          "articleSection": categoryNames.join(", "),
          "keywords": seoKeywords,
          "wordCount": post.content ? post.content.replace(/<[^>]*>/g, '').length : 0,
          "inLanguage": "ja-JP",
          "potentialAction": {
            "@type": "ReadAction",
            "target": [Astro.url.href]
          }
    })}</script>

    <script type="application/ld+json" is:inline>{JSON.stringify({
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "ホーム",
              "item": Astro.site
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "ブログ",
              "item": new URL("/blog", Astro.site).href
            },
            categoryNames.length > 0 ? {
              "@type": "ListItem",
              "position": 3,
              "name": categoryNames[0],
              "item": new URL(`/category/${encodeURIComponent(categoryNames[0])}`, Astro.site).href
            } : null,
            {
              "@type": "ListItem",
              "position": categoryNames.length > 0 ? 4 : 3,
              "name": post.title,
              "item": Astro.url.href
            }
          ].filter(Boolean)
    })}</script>
  </Fragment>

  <main class="min-h-screen transition-colors duration-200" style="background: var(--color-bg-primary);">
    <!-- 読書進捗バー -->
    <div class="reading-progress-container" aria-hidden="true">
      <div id="reading-progress" class="reading-progress-bar" />
    </div>
    <div class="container mx-auto px-4 py-8 md:py-12 max-w-6xl blog-global-font">
      {draftKey && (
        <div class="mb-6 rounded-lg border px-4 py-3 text-sm" style="border-color: #eab308; background: rgba(234, 179, 8, 0.1); color: var(--color-text-primary);">
          プレビュー表示中（未公開の下書き）。このページは検索エンジンにインデックスされません。
        </div>
      )}
      <!-- パンくず -->
      <Breadcrumb items={breadcrumbItems} class="mb-6" />

      <div class="relative flex gap-4 lg:gap-6">
        <!-- 左サイドバー（リアクションバー） - PC表示のみ -->
        <aside class="hidden lg:block flex-shrink-0 w-14">
          <StickyReactionBar client:load blogId={post.id} title={post.title} />
        </aside>

        <div class="flex-1 grid grid-cols-1 lg:grid-cols-6 lg:gap-6">
        <!-- メインコンテンツ -->
        <article class="lg:col-span-4" itemscope itemtype="https://schema.org/BlogPosting">
          <div
            class="rounded-xl border overflow-hidden transition-colors duration-200"
            style="background: var(--color-bg-card); border-color: var(--color-border);"
          >
            {
              post.eyecatch?.url ? (
                <div class="relative h-[300px] overflow-hidden mb-0">
                  <div
                    class="absolute inset-0 bg-cover bg-center"
                    style={`background-image: url(${post.eyecatch.url}?w=1200&blur=20&q=50);`}
                  />
                  <div class="absolute inset-0 bg-black/30" />
                  <Image
                    src={post.eyecatch.url}
                    width={1200}
                    height={630}
                    alt={`「${post.title}」のアイキャッチ画像`}
                    class="relative w-full h-full object-contain"
                  />
                  <header class="absolute bottom-0 left-0 right-0 p-6 md:p-8 bg-gradient-to-t from-black/60 to-transparent text-white">
                    <h1 class="text-2xl md:text-3xl font-bold mb-2">
                      {post.title}
                    </h1>
                    <div class="flex items-center flex-wrap gap-x-4 gap-y-2 text-sm text-slate-200">
                      <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined align-middle text-base" style="color: #bae6fd;">arrow_circle_up</span>
                        <time datetime={post.publishedAt}>
                          {new Date(post.publishedAt || "").toLocaleDateString("ja-JP")}
                        </time>
                      </div>
                      <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined align-middle text-base" style="color: #fbbf24;">cached</span>
                        <time datetime={post.updatedAt}>
                          {new Date(post.updatedAt || post.publishedAt || "").toLocaleDateString("ja-JP")}
                        </time>
                      </div>
                    </div>
                  </header>
                </div>
              ) : (
                <div class="px-6 md:px-8 pt-8">
                  <h1 class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--color-text-heading);">
                    {post.title}
                  </h1>
                  <div class="flex items-center flex-wrap gap-x-4 gap-y-2 text-sm mb-6" style="color: var(--color-text-tertiary);">
                    <div class="flex items-center gap-1.5">
                      <span class="material-symbols-outlined align-middle text-base">arrow_circle_up</span>
                      <time datetime={post.publishedAt}>
                        {new Date(post.publishedAt || "").toLocaleDateString("ja-JP")}
                      </time>
                    </div>
                  </div>
                </div>
              )
            }

            <!-- 目次（モバイル） -->
            <div class="block lg:hidden px-4 pb-4">
              <div
                class="p-4 rounded-xl border transition-colors duration-200"
                style="background: var(--color-bg-secondary); border-color: var(--color-border);"
              >
                <h3 class="font-bold text-sm mb-3" style="color: var(--color-text-heading);">目次</h3>
                <ul class="toc-list">
                  {
                    headings.map((heading) => (
                      <li class={heading.tagName === "h2" ? "toc-h2" : "toc-h3"}>
                        <a href={`#${heading.id}`}>{heading.text}</a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>

            <!-- 本文 -->
            <div class="blog-article-content article-content">
              <Fragment set:html={post.content} />
            </div>

            <CodeBlockEnhancer />
            <LinkStyleEnhancer />
            <ImageOptimizer />
            <KeyboardNavigation />

            <!-- リアクション + シェア -->
            <div class="mt-6 px-4 md:px-8 pb-6">
              <div class="flex flex-col gap-4">
                {!draftKey && (
                  <div class="flex items-start gap-3">
                    <div class="reaction-buttons flex-1">
                      <ReactionButtons client:load blogId={post.id} />
                    </div>
                    <BookmarkButton client:load blogId={post.id} title={post.title} />
                  </div>
                )}

                <div class="share-buttons-container">
                  <button id="share-x" class="share-btn twitter" type="button" aria-label="Xでシェア" title="Xでシェア">
                    <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M18.9 2H22l-7.7 8.8L23.5 22H16l-5.2-6.8L4.8 22H2l8.3-9.5L.7 2h7l4.7 6.2L18.9 2z"/>
                    </svg>
                    <span class="share-label">Xでシェア</span>
                  </button>
                  <button id="share-linkedin" class="share-btn linkedin" type="button" aria-label="LinkedInでシェア" title="LinkedInでシェア">
                    <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M19 3A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3H19M8.34 17.34V10.5H6V17.34H8.34M7.17 9.41A1.41 1.41 0 1 0 7.17 6.59 1.41 1.41 0 0 0 7.17 9.41M18 17.34V13.61C18 11.5 16.88 10.41 15.19 10.41A3 3 0 0 0 12.88 11.65H12.84V10.5H10.5V17.34H12.88V13.98C12.88 13 13.06 12.08 14.22 12.08C15.36 12.08 15.38 13.12 15.38 14.04V17.34H18Z"/>
                    </svg>
                    <span class="share-label">LinkedIn</span>
                  </button>
                  <button id="share-copy" class="share-btn copy" type="button" aria-label="リンクをコピー" title="リンクをコピー">
                    <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M19 21H8V7H19M19 3H7A2 2 0 0 0 5 5V19A2 2 0 0 0 7 21H19A2 2 0 0 0 21 19V5A2 2 0 0 0 19 3M3 17V3H17V1H3A2 2 0 0 0 1 3V17H3Z"/>
                    </svg>
                    <span class="share-label">コピー</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- カテゴリハッシュタグ -->
          <div class="mt-6 flex flex-wrap gap-2">
            {
              Array.isArray(post.category)
                ? post.category.map((cat) => (
                    <a
                      href={`/category/${cat}/`}
                      class={getCategoryBadgeClasses(cat)}
                      style="text-decoration: none;"
                    >
                      <span class={`${getCategoryIconClass(cat)} text-base`}>#</span>
                      {cat}
                    </a>
                  ))
                : post.category && (
                    <a
                      href={`/category/${post.category}/`}
                      class={getCategoryBadgeClasses(post.category)}
                      style="text-decoration: none;"
                    >
                      <span class={`${getCategoryIconClass(post.category)} text-base`}>#</span>
                      {post.category}
                    </a>
                  )
            }
          </div>

          <ArticleNavigation currentId={post.id} allArticles={allBlogs.contents} />

          {!draftKey && (
            <div
              class="mt-8 p-6 md:p-8 rounded-xl border transition-colors duration-200"
              style="background: var(--color-bg-card); border-color: var(--color-border);"
            >
              <h2 class="text-xl font-bold mb-6" style="color: var(--color-text-heading);">コメント</h2>
              <Comments
                pageUrl={Astro.url.href}
                pageIdentifier={post.id}
                pageTitle={post.title}
              />
            </div>
          )}
        </article>

        <!-- サイドバー (目次 + 著者カード) PCのみ -->
        <aside class="lg:col-span-2 hidden lg:block">
          <div class="lg:sticky lg:top-20">
            <div
              class="toc-container p-4 rounded-xl border transition-colors duration-200"
              style="background: var(--color-bg-secondary); border-color: var(--color-border);"
            >
              <h3 class="font-bold text-sm mb-2 flex-shrink-0" style="color: var(--color-text-heading);">目次</h3>
              <div class="toc-scroll-area">
                <TableOfContents client:load headings={headings} />
              </div>
            </div>

            <div class="mt-4">
              <AuthorCard />
            </div>
          </div>
        </aside>
        </div>
      </div>

      <!-- 関連記事 -->
      {relatedPosts.length > 0 && (
        <section class="mt-12">
          <h2 class="text-xl font-bold mb-6" style="color: var(--color-text-heading);">関連記事</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {relatedPosts.map((p: any) => (
              <ArticleCard
                id={p.id}
                title={p.title}
                description={p.description}
                date={new Date(p.publishedAt || p.createdAt).toLocaleDateString('ja-JP')}
                imageUrl={p.eyecatch?.url || '/placeholder.svg'}
                category={p.category}
                content={p.content}
                showReadingTime={true}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>

<script>
  import { setupShareButtons } from '../../lib/share-buttons';
  import { setupReadingProgress } from '../../lib/reading-progress';

  document.addEventListener('DOMContentLoaded', setupShareButtons);
  document.addEventListener('astro:page-load', setupShareButtons);

  document.addEventListener('DOMContentLoaded', setupReadingProgress);
  document.addEventListener('astro:page-load', setupReadingProgress);
</script>
