---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalDrafts } from '../lib/blogs';
import EditorialPageHeader from '../components/EditorialPageHeader.astro';

if (!import.meta.env.DEV) return new Response(null, { status: 404 });
const drafts = await getLocalDrafts();
---

<BaseLayout pageTitle="ローカル下書き" noIndex={true}>
  <main class="editorial-page">
    <div class="editorial-page-shell">
    <EditorialPageHeader eyebrow="LOCAL DRAFTS" title="ローカル下書き" description="この一覧は開発サーバー専用です。下書きファイルは Git 管理外に置いてください。" />
    <ul class="editorial-category-list">
      {drafts.map((draft) => <li><a href={draft.urlPath}><span>{draft.title}</span><span>→</span></a></li>)}
    </ul>
    {drafts.length === 0 && <p>npm run article:new -- article-id "記事タイトル" で下書きを作成できます。</p>}
    </div>
  </main>
</BaseLayout>
