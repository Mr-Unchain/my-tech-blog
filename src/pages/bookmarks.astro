---
// src/pages/bookmarks.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import BookmarkListClient from "../components/BookmarkListClient";
import EditorialPageHeader from "../components/EditorialPageHeader.astro";

const breadcrumbItems = [
  { name: "ホーム", href: "/" },
  { name: "ブックマーク" },
];
---

<BaseLayout
  pageTitle="ブックマーク"
  pageDescription="ブックマーク済みの記事一覧"
  noIndex={true}
>
  <main class="editorial-page editorial-bookmarks">
    <div class="editorial-page-shell">
      <Breadcrumb items={breadcrumbItems} />
      <EditorialPageHeader eyebrow="SAVED ARTICLES" title="ブックマーク" description="あとで読みたい記事をまとめて確認できます。" />
      <div class="editorial-bookmarks__list"><BookmarkListClient client:load /></div>
    </div>
  </main>
</BaseLayout>
