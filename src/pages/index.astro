---
// src/pages/index.astro
import { collection, getDocs, limit, orderBy, query } from "firebase/firestore";
import ArticleCard from "../components/ArticleCard.astro";
import HeroRecommendations from "../components/HeroSlideshowReact";
import Sidebar from "../components/Sidebar.astro";
import TabNavigation from "../components/TabNavigation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { db } from "../lib/firebase";
import { getBlogs, type Blog } from "../lib/microcms";

// ★ 人気記事取得（推薦カード用）
let heroPosts: Blog[] = [];
if (db) {
  const viewsQuery = query(
    collection(db, "views"),
    orderBy("count", "desc"),
    limit(3)
  );
  const querySnapshot = await getDocs(viewsQuery);
  const popularPostIds = querySnapshot.docs.map((doc) => doc.id);

  if (popularPostIds.length > 0) {
    const filters = popularPostIds.map((id) => `id[equals]${id}`).join("[or]");
    const { contents: microCMSData } = await getBlogs({
      filters: filters,
    });
    heroPosts = popularPostIds
      .map((id) => {
        const post = microCMSData.find((post: Blog) => post.id === id);
        if (!post) return undefined;
        return {
          ...post,
          category: Array.isArray(post.category)
            ? [...post.category]
            : [post.category],
        };
      })
      .filter((post): post is Blog => !!post);
  }
}

// ★ ページネーション
const PAGE_SIZE = 20;
const pageParam = Astro.url.searchParams.get("page");
const currentPage = pageParam ? Math.max(1, parseInt(pageParam)) : 1;
const offset = (currentPage - 1) * PAGE_SIZE;

// ★ タブナビゲーション
const activeTab = Astro.url.searchParams.get("tab") || "latest";

// タブに応じた記事取得
let pagedPosts: Blog[] = [];
let totalCount = 0;

if (activeTab === "popular" && db) {
  // 人気タブ: Firestoreのビュー数順で取得
  const popQuery = query(
    collection(db, "views"),
    orderBy("count", "desc"),
    limit(PAGE_SIZE)
  );
  const popSnapshot = await getDocs(popQuery);
  const popIds = popSnapshot.docs.map((doc) => doc.id);

  if (popIds.length > 0) {
    const filters = popIds.map((id) => `id[equals]${id}`).join("[or]");
    const { contents: popPosts } = await getBlogs({ filters });
    // Firestoreの順序を維持
    pagedPosts = popIds
      .map((id) => popPosts.find((p: Blog) => p.id === id))
      .filter((p): p is Blog => !!p);
    totalCount = pagedPosts.length;
  }
} else if (activeTab.startsWith("category-")) {
  // カテゴリタブ: microCMSのフィルタで絞り込み
  const categoryName = decodeURIComponent(activeTab.replace("category-", ""));
  const { contents, totalCount: tc } = await getBlogs({
    orders: "-publishedAt",
    filters: `category[contains]${categoryName}`,
    limit: PAGE_SIZE,
    offset,
  });
  pagedPosts = contents;
  totalCount = tc;
} else {
  // 最新タブ（デフォルト）
  const { contents, totalCount: tc } = await getBlogs({
    orders: "-publishedAt",
    limit: PAGE_SIZE,
    offset,
  });
  pagedPosts = contents;
  totalCount = tc;
}
const totalPages = Math.ceil((totalCount || 0) / PAGE_SIZE);
const categoryChips: string[] = Array.from(
  new Set(
    (pagedPosts as Blog[]).flatMap((p: Blog) =>
      Array.isArray(p.category)
        ? (p.category as string[])
        : (p.category ? [String(p.category)] : [])
    )
  )
).slice(0, 6);

// カノニカルURL
const canonicalHome = (() => {
  const url = new URL('/', Astro.site);
  if (currentPage > 1) url.searchParams.set('page', String(currentPage));
  return url.href;
})();
---

<BaseLayout
  pageTitle="気づきメモ - 最新の記事"
  pageDescription="ITに触れて生まれた日々の気づきや備忘録をゆるくまとめています。ガジェットや開発の小ネタ、作業をラクにするヒントなど。"
  keywords="テクノロジー, ガジェット, 開発, プログラミング, コーディング, AI, Web開発, JavaScript, React, Astro, 備忘録, 気づき"
  canonicalUrl={canonicalHome}
>
  <Fragment slot="head">
    {
      [
        ...(heroPosts || []).slice(0,3).map((p: Blog) => p.eyecatch?.url).filter(Boolean),
        ...(pagedPosts || []).slice(0,3).map((p: Blog) => p.eyecatch?.url).filter(Boolean)
      ].slice(0,6).map((url: string) => (
        <link rel="preload" as="image" href={`${url}?w=800&q=70`} />
      ))
    }
  </Fragment>
  <script slot="head" type="application/ld+json" is:inline>{JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Blog",
        "name": "Monologger",
        "description": "ITの気づきや備忘録をゆるく残すブログ",
        "url": Astro.site,
        "author": {
          "@type": "Person",
          "name": "Monologger",
          "url": new URL("/profile", Astro.site).href
        },
        "publisher": {
          "@type": "Organization",
          "name": "Monologger",
          "logo": {
            "@type": "ImageObject",
            "url": new URL("/logo.svg", Astro.site).href
          }
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": Astro.site
        },
        "blogPost": pagedPosts.slice(0, 10).map(post => ({
          "@type": "BlogPosting",
          "headline": post.title,
          "description": post.description,
          "url": new URL(`/blog/${post.id}`, Astro.site).href,
          "datePublished": post.publishedAt,
          "author": {
            "@type": "Person",
            "name": "Monologger"
          },
          "image": post.eyecatch?.url || new URL("/placeholder.svg", Astro.site).href
        }))
      })}
  </script>

  <main class="min-h-screen transition-colors duration-200" style="background: var(--color-bg-primary);">
    <!-- ヘッダーエリア: 検索 + タイトル -->
    <section class="border-b transition-colors duration-200" style="border-color: var(--color-border);">
      <div class="container mx-auto px-4 md:px-6 pt-8 pb-6 max-w-7xl">
        <h1 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--color-text-heading);">
          気づきメモ
        </h1>
        <p class="text-sm md:text-base mb-5" style="color: var(--color-text-secondary);">
          ITに触れて生まれた日々の気づきや備忘録をゆるくまとめています。
        </p>
        <form id="fv-search" method="get" action="/search" class="flex w-full max-w-xl rounded-lg overflow-hidden border transition-colors duration-200" style="border-color: var(--color-border);">
          <input
            name="q"
            id="fv-q"
            list="fv-suggest"
            class="flex-1 px-4 py-2.5 text-sm focus:outline-none transition-colors duration-200"
            style="background: var(--color-bg-secondary); color: var(--color-text-primary);"
            placeholder="記事を検索..."
          />
          <datalist id="fv-suggest"></datalist>
          <button type="submit" class="px-4 text-white text-sm font-medium" style="background: var(--color-accent);">
            検索
          </button>
        </form>
      </div>
    </section>

    <!-- 推薦記事（人気記事） -->
    {heroPosts.length > 0 && (
      <section class="border-b transition-colors duration-200" style="border-color: var(--color-border);">
        <div class="container mx-auto px-4 md:px-6 py-6 max-w-7xl">
          <h2 class="text-lg font-bold mb-4" style="color: var(--color-text-heading);">
            おすすめ記事
          </h2>
          <HeroRecommendations client:idle posts={heroPosts} />
        </div>
      </section>
    )}

    <!-- タブナビゲーション -->
    <div class="container mx-auto px-4 md:px-6 max-w-7xl">
      <TabNavigation activeTab={activeTab} categories={categoryChips} />
    </div>

    <!-- メインコンテンツ -->
    <div class="container mx-auto px-4 md:px-6 py-8 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 lg:gap-12">
        <div class="lg:col-span-3">
          <section>
            <!-- ビュー切替 -->
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-xl font-bold" style="color: var(--color-text-heading);">
                {activeTab === "popular" ? "人気記事" : activeTab.startsWith("category-") ? `#${decodeURIComponent(activeTab.replace("category-", ""))}` : "最新記事"}
              </h2>
              <div class="flex space-x-2">
                <button
                  id="view-grid"
                  title="グリッド表示"
                  aria-label="記事をグリッド形式で表示"
                  class="p-2 rounded-lg border transition-colors duration-200"
                  style="border-color: var(--color-border); color: var(--color-accent); background: var(--color-bg-secondary);"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM13 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2h-2z"></path>
                  </svg>
                </button>
                <button
                  id="view-list"
                  title="リスト表示"
                  aria-label="記事をリスト形式で表示"
                  class="p-2 rounded-lg border transition-colors duration-200"
                  style="border-color: var(--color-border); color: var(--color-text-muted); background: var(--color-bg-secondary);"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
            </div>

            <!-- 記事グリッド -->
            <div
              id="article-list-container"
              class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5"
              style="transition: all 0.3s ease;"
            >
              {
                pagedPosts.map((post: Blog) => (
                  <ArticleCard
                    class="article-card"
                    id={post.id}
                    category={post.category}
                    title={post.title}
                    description={post.description}
                    date={
                      post.publishedAt
                        ? new Date(post.publishedAt).toLocaleDateString("ja-JP")
                        : ""
                    }
                    imageUrl={
                      post.eyecatch?.url
                        ? post.eyecatch.url + "?w=400&h=225&fit=crop"
                        : "/placeholder.svg"
                    }
                    imageUrlList={
                      post.eyecatch?.url
                        ? post.eyecatch.url + "?w=320&h=180&fit=crop"
                        : "/placeholder.svg"
                    }
                  />
                ))
              }
            </div>

            <!-- ページネーション -->
            {totalPages > 1 && (
              <div class="mt-10 flex justify-center">
                <nav class="flex items-center space-x-2">
                  <a
                    href={`?page=${currentPage - 1}`}
                    class:list={[
                      'flex items-center justify-center h-10 w-10 rounded-lg border text-sm transition-colors duration-200',
                      currentPage === 1 ? 'pointer-events-none opacity-40' : '',
                    ]}
                    style={`border-color: var(--color-border); color: var(--color-text-secondary); background: var(--color-bg-card);`}
                    aria-label="前のページへ"
                    rel="prev"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                  </a>
                  {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) =>
                    page === currentPage ? (
                      <span
                        aria-current="page"
                        class="flex items-center justify-center h-10 w-10 text-white font-bold rounded-lg text-sm"
                        style="background: var(--color-accent);"
                      >
                        {page}
                      </span>
                    ) : (
                      <a
                        href={`?page=${page}`}
                        class="flex items-center justify-center h-10 w-10 rounded-lg border text-sm transition-colors duration-200 hover:opacity-80"
                        style={`border-color: var(--color-border); color: var(--color-text-secondary); background: var(--color-bg-card);`}
                        aria-label={`${page}ページ目へ`}
                        rel={page === currentPage - 1 ? 'prev' : page === currentPage + 1 ? 'next' : undefined}
                      >
                        {page}
                      </a>
                    )
                  )}
                  <a
                    href={`?page=${currentPage + 1}`}
                    class:list={[
                      'flex items-center justify-center h-10 w-10 rounded-lg border text-sm transition-colors duration-200',
                      currentPage === totalPages ? 'pointer-events-none opacity-40' : '',
                    ]}
                    style={`border-color: var(--color-border); color: var(--color-text-secondary); background: var(--color-bg-card);`}
                    aria-label="次のページへ"
                    rel="next"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  </a>
                </nav>
              </div>
            )}

            <!-- ブログ一覧へのリンク -->
            <div class="mt-10 text-center">
              <a
                href="/blog"
                class="inline-flex items-center space-x-2 px-6 py-3 text-sm font-medium rounded-lg border transition-colors duration-200 hover:opacity-80"
                style={`border-color: var(--color-border); color: var(--color-accent); background: var(--color-bg-card);`}
              >
                <span>すべての記事を見る</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>
            </div>
          </section>
        </div>
        <Sidebar />
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { initializeViewToggle } from '../lib/view-toggle';
  import { initializeSearchHistory } from '../lib/search-history';

  document.addEventListener('astro:page-load', initializeViewToggle);
  document.addEventListener('swup:contentReplaced', initializeViewToggle);
  document.addEventListener('DOMContentLoaded', initializeViewToggle);

  initializeSearchHistory();
</script>
