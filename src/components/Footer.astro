---
// src/components/Footer.astro
const today = new Date();
---

<footer class="bg-gray-50 dark:bg-slate-900 border-t border-gray-200 dark:border-slate-800 transition-colors duration-200">
  <div class="container mx-auto px-4 md:px-6 max-w-7xl py-12 md:py-16">
    <!-- 4-Section Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      <!-- About -->
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center space-x-2 mb-4">
          <img src="/logo.svg" alt="Monologger" class="w-6 h-6" />
          <span class="font-bold text-slate-800 dark:text-white">Monologger</span>
        </div>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
          ITの気づきや備忘録をゆるく残すブログ。ツールや小ワザ、学びの断片を記録しています。
        </p>
      </div>

      <!-- Navigation Links -->
      <div>
        <h3 class="text-sm font-semibold text-slate-800 dark:text-white mb-4">コンテンツ</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="/blog" class="text-sm text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 transition-colors duration-200">
              ブログ
            </a>
          </li>
          <li>
            <a href="/portfolio" class="text-sm text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 transition-colors duration-200">
              ポートフォリオ
            </a>
          </li>
          <li>
            <a href="/profile" class="text-sm text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 transition-colors duration-200">
              プロフィール
            </a>
          </li>
          <li>
            <a href="/search" class="text-sm text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 transition-colors duration-200">
              検索
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-sm font-semibold text-slate-800 dark:text-white mb-4">ポリシー</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="/privacy" class="text-sm text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 transition-colors duration-200">
              プライバシーポリシー
            </a>
          </li>
          <li>
            <a href="/contact" class="text-sm text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 transition-colors duration-200">
              お問い合わせ
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="text-sm text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 transition-colors duration-200">
              RSS フィード
            </a>
          </li>
        </ul>
      </div>

      <!-- Tech Stack -->
      <div>
        <h3 class="text-sm font-semibold text-slate-800 dark:text-white mb-4">技術スタック</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 transition-colors duration-200">
              Astro
            </a>
          </li>
          <li>
            <a href="https://www.typescriptlang.org/" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 transition-colors duration-200">
              TypeScript
            </a>
          </li>
          <li>
            <a href="https://tailwindcss.com/" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 transition-colors duration-200">
              Tailwind CSS
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 pt-6 border-t border-gray-200 dark:border-slate-800">
      <p class="text-center text-sm text-slate-400 dark:text-slate-500">
        &copy; {today.getFullYear()} Monologger. All rights reserved.
      </p>
    </div>
  </div>
</footer>
