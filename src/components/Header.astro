---
// src/components/Header.astro
import ThemeToggle from './ThemeToggle.tsx';
---

<header class="bg-white dark:bg-slate-900 border-b border-gray-200 dark:border-slate-800 sticky top-0 z-[1000] transition-colors duration-200">
  <div class="container mx-auto px-4 md:px-6 max-w-7xl">
    <div class="flex items-center justify-between h-14 md:h-16">
      <!-- Logo Section -->
      <a href="/" class="flex items-center space-x-2 group" data-testid="header-logo">
        <img
          src="/logo.svg"
          alt="Monologger ロゴ"
          class="w-8 h-8 transition-transform duration-200 group-hover:scale-105"
        />
        <span class="text-xl font-bold text-slate-800 dark:text-white transition-colors duration-200">
          Monologger
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1" data-testid="header-nav">
        <a
          href="/blog"
          class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-100 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
        >
          ブログ
        </a>
        <a
          href="/portfolio"
          class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-100 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
        >
          ポートフォリオ
        </a>
        <a
          href="/profile"
          class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-100 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
        >
          プロフィール
        </a>
        <a
          href="/bookmarks"
          class="p-2 text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-100 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
          aria-label="ブックマーク一覧"
          data-testid="header-bookmark-link"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M5 2h14a1 1 0 011 1v19.143a.5.5 0 01-.766.424L12 18.03l-7.234 4.536A.5.5 0 014 22.143V3a1 1 0 011-1z"></path>
          </svg>
        </a>
        <a
          href="/search"
          class="p-2 text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-100 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
          aria-label="検索ページへ移動"
          data-testid="header-search-link"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </a>
        <div class="ml-1 pl-2 border-l border-gray-200 dark:border-slate-700">
          <ThemeToggle client:load />
        </div>
      </nav>

      <!-- Mobile: ThemeToggle + Menu Button -->
      <div class="flex items-center space-x-2 md:hidden">
        <ThemeToggle client:load />
        <button
          id="mobile-menu-button"
          class="p-2 text-slate-600 dark:text-slate-300 hover:text-slate-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-cyan-400"
          aria-label="メニューを開く"
          data-testid="mobile-menu-button"
        >
          <div class="w-5 h-5 flex flex-col justify-center items-center space-y-1">
            <span class="block w-5 h-0.5 bg-current rounded-full"></span>
            <span class="block w-5 h-0.5 bg-current rounded-full"></span>
            <span class="block w-5 h-0.5 bg-current rounded-full"></span>
          </div>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu-overlay"
    class="md:hidden fixed inset-0 bg-black/50 dark:bg-black/70 z-[9998] opacity-0 pointer-events-none transition-opacity duration-300"
  ></div>

  <!-- Mobile Menu Sidebar -->
  <div
    id="mobile-menu"
    class="md:hidden fixed top-0 right-0 h-screen w-72 max-w-[80vw] bg-white dark:bg-slate-900 border-l border-gray-200 dark:border-slate-700 shadow-xl z-[9999] transform translate-x-full transition-transform duration-300 ease-out overflow-hidden"
  >
    <!-- Header -->
    <div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-slate-700">
      <h2 class="text-lg font-bold text-slate-800 dark:text-white">メニュー</h2>
      <button
        id="mobile-menu-close"
        class="p-2 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
        aria-label="メニューを閉じる"
        data-testid="mobile-menu-close"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Menu Items -->
    <div class="p-4 flex-1 overflow-y-auto">
      <div class="space-y-1">
        <a
          href="/"
          class="menu-item flex items-center px-3 py-3 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
        >
          <svg class="w-5 h-5 mr-3 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <span class="font-medium">ホーム</span>
        </a>
        <a
          href="/blog"
          class="menu-item flex items-center px-3 py-3 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
        >
          <svg class="w-5 h-5 mr-3 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
          </svg>
          <span class="font-medium">ブログ</span>
        </a>
        <a
          href="/portfolio/"
          class="menu-item flex items-center px-3 py-3 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
        >
          <svg class="w-5 h-5 mr-3 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z"></path>
          </svg>
          <span class="font-medium">ポートフォリオ</span>
        </a>
        <a
          href="/profile/"
          class="menu-item flex items-center px-3 py-3 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
        >
          <svg class="w-5 h-5 mr-3 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span class="font-medium">プロフィール</span>
        </a>

        <div class="my-2 border-t border-gray-100 dark:border-slate-700"></div>

        <a
          href="/bookmarks/"
          class="menu-item flex items-center px-3 py-3 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
        >
          <svg class="w-5 h-5 mr-3 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M5 2h14a1 1 0 011 1v19.143a.5.5 0 01-.766.424L12 18.03l-7.234 4.536A.5.5 0 014 22.143V3a1 1 0 011-1z"></path>
          </svg>
          <span class="font-medium">ブックマーク</span>
        </a>
        <a
          href="/search/"
          class="menu-item flex items-center px-3 py-3 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-cyan-400 hover:bg-gray-50 dark:hover:bg-slate-800 rounded-lg transition-colors duration-200"
        >
          <svg class="w-5 h-5 mr-3 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span class="font-medium">検索</span>
        </a>
      </div>
    </div>

    <!-- Footer -->
    <div class="p-4 border-t border-gray-200 dark:border-slate-700">
      <p class="text-center text-xs text-slate-400 dark:text-slate-500">&copy; 2025 Monologger</p>
    </div>
  </div>
</header>

<script>
  import { initializeMobileMenu, setupMobileMenuGlobalHandlers } from '../lib/mobile-menu';

  document.addEventListener('DOMContentLoaded', initializeMobileMenu);
  document.addEventListener('astro:page-load', initializeMobileMenu);

  setupMobileMenuGlobalHandlers();
</script>
