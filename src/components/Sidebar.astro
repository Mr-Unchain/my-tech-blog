---
// src/components/Sidebar.astro
import { collection, getDocs, limit, orderBy, query } from "firebase/firestore";
import { db } from "../lib/firebase";
import { getBlogs, getProfile, type Blog } from "../lib/microcms";

interface Props {
  hideCategories?: boolean;
}

const { hideCategories = false } = Astro.props;

// プロフィール情報を取得
const profile = await getProfile();

// 人気記事の取得ロジック（db null チェック付き）
let popularPosts: Pick<Blog, "id" | "title">[] = [];
if (db) {
  const viewsQuery = query(
    collection(db, "views"),
    orderBy("count", "desc"),
    limit(5)
  );
  const querySnapshot = await getDocs(viewsQuery);
  const popularPostIds = querySnapshot.docs.map((doc) => doc.id);

  if (popularPostIds.length > 0) {
    const filters = popularPostIds.map((id) => `id[equals]${id}`).join("[or]");
    const { contents: microCMSData } = await getBlogs({
      filters: filters,
      fields: "id,title",
    });
    popularPosts = popularPostIds
      .map((id) => microCMSData.find((post: { id: string }) => post.id === id))
      .filter((post): post is Blog => !!post);
  }
}

// カテゴリーの取得と記事数のカウント
let uniqueCategories: string[] = [];
let categoryCounts: Record<string, number> = {};

if (!hideCategories) {
  const { contents: postsForCategories } = await getBlogs({
    fields: "id,category",
  });
  const allCategories: string[] = postsForCategories.flatMap(
    (post: { category: string | string[] }) =>
      Array.isArray(post.category) ? post.category : [post.category]
  );

  categoryCounts = allCategories.reduce(
    (acc: Record<string, number>, category: string) => {
      acc[category] = (acc[category] || 0) + 1;
      return acc;
    },
    {} as Record<string, number>
  );

  uniqueCategories = [...new Set(allCategories)];
}
---

<aside class="space-y-6">
  <!-- プロフィール -->
  <div class="sidebar-card">
    {
      profile.avatar && (
        <a href="/profile/" class="block text-center">
          <img
            class="w-20 h-20 rounded-full mx-auto mb-3 transition-all duration-200"
            style="border: 3px solid var(--color-border);"
            src={profile.avatar.url}
            alt="筆者のアバター"
          />
        </a>
      )
    }
    <h3 class="font-bold text-base text-center" style="color: var(--color-text-heading);">
      {profile.name}
    </h3>
    <p class="text-sm mt-2 text-center" style="color: var(--color-text-secondary);">
      {profile.description}
    </p>
    <div class="flex justify-center space-x-4 mt-4">
      {
        profile.xUrl && (
          <a
            href={profile.xUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-200"
            style="color: var(--color-text-muted);"
            aria-label="Xのプロフィールを見る"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
        )
      }
      {
        profile.githubUrl && (
          <a
            href={profile.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-200"
            style="color: var(--color-text-muted);"
            aria-label="GitHubのプロフィールを見る"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.168 6.839 9.492.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.031-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.378.203 2.398.1 2.651.64.7 1.03 1.595 1.03 2.688 0 3.848-2.338 4.695-4.566 4.942.359.308.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.001 10.001 0 0022 12c0-5.523-4.477-10-10-10z" />
            </svg>
          </a>
        )
      }
    </div>
  </div>

  <!-- 検索 -->
  <div class="sidebar-card">
    <h3 class="sidebar-heading">記事を探す</h3>
    <form action="/search" method="get" class="flex rounded-lg overflow-hidden border" style="border-color: var(--color-border);">
      <input
        type="search"
        name="q"
        placeholder="キーワード..."
        class="flex-1 px-3 py-2 text-sm focus:outline-none transition-colors duration-200"
        style="background: var(--color-bg-secondary); color: var(--color-text-primary);"
      />
      <button
        type="submit"
        class="px-3 py-2 text-white transition-colors duration-200"
        style="background: var(--color-accent);"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </button>
    </form>
  </div>

  <!-- 人気記事 -->
  <div class="sidebar-card">
    <h3 class="sidebar-heading">人気記事</h3>
    {
      popularPosts.length > 0 ? (
        <ol class="space-y-2">
          {popularPosts.map(
            (post, index) =>
              post && (
                <li class="flex items-start py-2" style={index < popularPosts.length - 1 ? `border-bottom: 1px solid var(--color-border-light);` : ''}>
                  <span class="text-sm font-bold mr-3 flex-shrink-0" style="color: var(--color-accent);">
                    {index + 1}
                  </span>
                  <a
                    href={`/blog/${post.id}/`}
                    class="text-sm leading-snug transition-colors duration-200 hover:underline"
                    style="color: var(--color-text-primary);"
                  >
                    {post.title}
                  </a>
                </li>
              )
          )}
        </ol>
      ) : (
        <p class="text-sm" style="color: var(--color-text-muted);">人気記事はまだありません。</p>
      )
    }
  </div>

  <!-- カテゴリ -->
  {!hideCategories && (
    <div class="sidebar-card">
      <h3 class="sidebar-heading">カテゴリ</h3>
      <ul class="space-y-1">
        {
          uniqueCategories.map((category) => (
            <li>
              <a
                href={`/category/${category}/`}
                class="group flex justify-between items-center px-3 py-2 rounded-lg text-sm transition-colors duration-200"
                style="color: var(--color-text-primary);"
              >
                <span class="transition-colors duration-200">{category}</span>
                <span
                  class="text-xs font-medium px-2 py-0.5 rounded-full transition-colors duration-200"
                  style="background: var(--color-bg-tertiary); color: var(--color-text-secondary);"
                >
                  {categoryCounts[category]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  )}
</aside>

<style>
  .sidebar-card {
    padding: 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    transition: border-color 0.2s, background 0.2s;
  }

  .sidebar-heading {
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-heading);
  }

  aside a:hover {
    color: var(--color-accent) !important;
  }
</style>
