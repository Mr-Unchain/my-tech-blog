---
// src/components/ProjectCard.astro
import type { Project } from "../lib/microcms";

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const techStack = project.techStack || [];
const hasThumbnail = Boolean(project.thumbnail?.url);
const hasAchievements = Boolean(project.achievements);
const linkLabel = project.link?.includes("github.com")
  ? "GitHub"
  : "詳細を見る";
---

<article
  class="project-card group relative flex flex-col rounded-2xl p-6 shadow-xl transition-all duration-500 overflow-hidden hover:scale-[1.02] hover:-translate-y-1"
>
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
    style="background: linear-gradient(to right, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent, color-mix(in srgb, var(--color-accent-hover) 10%, transparent));"
  >
  </div>

  <div class="relative z-10 space-y-4">
    <div class="flex items-start gap-4">
      {
        hasThumbnail ? (
          <div class="relative group/thumb">
            <img
              src={project.thumbnail!.url}
              alt={`${project.title}のサムネイル`}
              class="w-20 h-20 rounded-xl object-cover shadow-lg transition-all duration-300"
              style="ring: 2px solid color-mix(in srgb, var(--color-accent) 30%, transparent);"
              loading="lazy"
              decoding="async"
            />
          </div>
        ) : (
          <div
            class="project-card__placeholder w-20 h-20 rounded-xl flex items-center justify-center font-bold text-lg shadow-lg transition-all duration-300"
          >
            {project.title.slice(0, 2)}
          </div>
        )
      }
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          {
            project.period && (
              <span class="project-card__badge text-xs px-3 py-1.5 rounded-full shadow-sm transition-colors duration-300">
                {project.period}
              </span>
            )
          }
          {
            project.role && (
              <span class="project-card__role-badge text-xs px-3 py-1.5 rounded-full font-semibold shadow-sm transition-all duration-300">
                {project.role}
              </span>
            )
          }
        </div>
        <h3 class="project-card__title mt-2 text-xl font-bold">
          {project.title}
        </h3>
        {
          project.summary && (
            <div
              class="project-card__summary mt-2 text-sm leading-relaxed line-clamp-3 prose prose-sm max-w-none transition-colors duration-300"
              set:html={project.summary}
            />
          )
        }
      </div>
    </div>

    {
      techStack.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {techStack.map((tech) => (
            <span class="project-card__tech text-xs px-3 py-1.5 rounded-full shadow-sm transition-all duration-300 cursor-default">
              {tech}
            </span>
          ))}
        </div>
      )
    }

    {
      hasAchievements && (
        <div class="project-card__achievements rounded-xl p-4 text-sm transition-all duration-300">
          <p class="project-card__achievements-title font-semibold mb-2 flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            担当領域・成果
          </p>
          <div
            class="leading-relaxed prose prose-sm max-w-none project-card__achievements-body"
            set:html={project.achievements}
          />
        </div>
      )
    }

    {
      project.link && (
        <div class="project-card__footer flex items-center justify-between pt-2">
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="project-card__link inline-flex items-center gap-2 text-sm font-semibold group/link transition-colors duration-300"
            aria-label={`${project.title} の詳細リンク`}
          >
            <span>{linkLabel}</span>
            <svg
              class="w-4 h-4 transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13.5 4.5h6v6m0-6L10 14l-3 3m12-12L14 10"
              />
            </svg>
          </a>
          <div class="project-card__date text-xs flex items-center gap-1.5">
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            {new Date(
              project.updatedAt || project.createdAt || new Date(),
            ).toLocaleDateString("ja-JP")}
          </div>
        </div>
      )
    }
  </div>
</article>

<style>
  .project-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
  }
  .project-card:hover {
    box-shadow: 0 20px 40px color-mix(in srgb, var(--color-accent) 15%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .project-card__placeholder {
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .project-card__badge {
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .project-card__role-badge {
    background: var(--color-accent-light);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-accent);
  }

  .project-card__title {
    color: var(--color-text-heading);
  }

  .project-card__summary {
    color: var(--color-text-secondary);
  }
  .project-card__summary :global(p) {
    color: var(--color-text-secondary);
  }

  .project-card__tech {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }
  .project-card__tech:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    color: var(--color-accent);
    background: var(--color-bg-tertiary);
  }

  .project-card__achievements {
    background: var(--color-accent-light);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-text-primary);
  }

  .project-card__achievements-title {
    color: var(--color-accent);
  }

  .project-card__achievements-body {
    color: var(--color-text-primary);
  }
  .project-card__achievements-body :global(p),
  .project-card__achievements-body :global(li) {
    color: var(--color-text-primary);
  }

  .project-card__footer {
    border-top: 1px solid var(--color-border);
  }

  .project-card__link {
    color: var(--color-accent);
  }
  .project-card__link:hover {
    color: var(--color-accent-hover);
  }

  .project-card__date {
    color: var(--color-text-muted);
  }
</style>
