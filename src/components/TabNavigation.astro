---
// src/components/TabNavigation.astro
export interface Props {
  activeTab: string;
  categories?: string[];
}

const { activeTab = 'latest', categories = [] } = Astro.props;

const baseTabs = [
  { id: 'latest', label: '最新', href: '/?tab=latest' },
  { id: 'popular', label: '人気', href: '/?tab=popular' },
];

const categoryTabs = categories.map((cat) => ({
  id: `category-${cat}`,
  label: `#${cat}`,
  href: `/?tab=category-${encodeURIComponent(cat)}`,
}));

const allTabs = [...baseTabs, ...categoryTabs];
---

<nav id="tab-navigation" class="border-b border-gray-200 dark:border-slate-700 transition-colors duration-200" data-testid="tab-navigation">
  <div class="overflow-x-auto scrollbar-hide">
    <div class="flex space-x-0 min-w-max">
      {allTabs.map((tab) => {
        const isActive = activeTab === tab.id;
        return (
          <a
            href={tab.href}
            class:list={[
              'px-4 py-3 text-sm font-medium border-b-2 whitespace-nowrap transition-colors duration-200',
              isActive
                ? 'border-blue-500 dark:border-cyan-400 text-blue-600 dark:text-cyan-400'
                : 'border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:border-gray-300 dark:hover:border-slate-600',
            ]}
            aria-current={isActive ? 'page' : undefined}
            data-testid={`tab-${tab.id}`}
          >
            {tab.label}
          </a>
        );
      })}
    </div>
  </div>
</nav>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function scrollToTabsIfNeeded() {
    const params = new URLSearchParams(window.location.search);
    if (params.has('tab')) {
      const nav = document.getElementById('tab-navigation');
      if (nav) {
        nav.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }

  // Handle initial page load
  scrollToTabsIfNeeded();

  // Handle Swup page transitions
  document.addEventListener('swup:contentReplaced', scrollToTabsIfNeeded);
</script>
